# ---------------------------------------------------------------------------
# Flask
# ---------------------------------------------------------------------------

# Flask environment: development or production (defaults to production)
FLASK_ENV=development

# ---------------------------------------------------------------------------
# AWS SSM Parameter Store
# ---------------------------------------------------------------------------
# All configuration is fetched from SSM at startup. No database env vars needed.
# The ECS task role must have ssm:GetParameter permission for:
#   - devISSU-admin-connect-string  (MongoDB connection string)
#   - devISSU-mongo-db              (MongoDB database name)
